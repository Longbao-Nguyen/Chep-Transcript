# ==============================================================================
# Required for MVP (works immediately with Kaggle Personal API Tokens, no OAuth)
# ==============================================================================

# App authentication (Google callback: /api/auth/callback/google)
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_BASE_URL=http://localhost:3000

# PostgreSQL database (Neon / Vercel Postgres)
DB_PROVIDER=postgres
DATABASE_URL=

# Private object storage (Vercel Blob uses OIDC with BLOB_STORE_ID on Vercel;
# local/non-OIDC environments may also provide BLOB_READ_WRITE_TOKEN)
STORAGE_PROVIDER=vercel-blob
BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=

# 32-byte key (base64 or 64-char hex) for AES-256-GCM encryption of user Kaggle tokens
KAGGLE_TOKEN_ENCRYPTION_KEY=

# Shared bearer secret protecting GET /api/cron/cleanup
CRON_SECRET=

# Retention and upload limits
JOB_RETENTION_HOURS=24
MAX_UPLOAD_BYTES=2147483648

# ==============================================================================
# Optional / Future (enable only after Kaggle approves OAuth 2.0 client)
# ==============================================================================
KAGGLE_OAUTH_ENABLED=false
KAGGLE_OAUTH_CLIENT_ID=
KAGGLE_OAUTH_CLIENT_SECRET=
KAGGLE_OAUTH_REDIRECT_URI=
