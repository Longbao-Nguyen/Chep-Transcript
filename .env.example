# App authentication (Google callback: /api/auth/callback/google)
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_BASE_URL=http://localhost:3000

# Provider-neutral selection; only the postgres adapter is implemented initially.
DB_PROVIDER=postgres
DATABASE_URL=

# Private Vercel Blob store. The connected project authenticates with Vercel OIDC.
STORAGE_PROVIDER=vercel-blob
BLOB_STORE_ID=

# Planned Milestones 5–6 only. Creating these does not enable unfinished code.
# See docs/environment-variables.md. Never use VITE_ prefixes for these values.
# KAGGLE_CLIENT_ID=org:<registered-organization-slug>
# KAGGLE_ORG_USERNAME=<organization-owner-user>
# KAGGLE_ORG_API_KEY=
# KAGGLE_REDIRECT_URI=https://<app-domain>/api/kaggle/callback
# KAGGLE_MODEL_DATASET=longnj/french-whisper-ct2/1
# TOKEN_ENCRYPTION_KEY=<base64-encoded-32-random-bytes>
# WORKER_CALLBACK_SECRET=<independent-random-secret>
# CRON_SECRET=<future-scheduler-secret>

# Optional; defaults to 2 GiB.
MAX_UPLOAD_BYTES=2147483648

# Optional: enables POST /api/ai/refine-french in server.ts.
GEMINI_API_KEY=

# Reserved by the legacy deployment documentation; current code does not read it.
APP_URL=http://localhost:3000
